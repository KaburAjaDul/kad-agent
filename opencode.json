{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openai"
  ],
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4",
  "default_agent": "research",
  "instructions": [
    "AGENTS.md",
    "ARCHITECTURE.md",
    "docs/design-docs/*.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".opencode/.output/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "doom_loop": "ask",
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "agent": {
    "build": {
      "description": "Primary build orchestrator for KAD-Agent",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./.opencode/prompts/build.txt}",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "ask",
        "task": {
          "*": "deny",
          "scoper": "allow",
          "researcher": "allow",
          "builder": "allow",
          "reviewer": "allow",
          "general": "deny",
          "explore": "deny"
        }
      }
    },
    "research": {
      "description": "Primary research orchestrator for KAD-Agent",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./.opencode/prompts/research.txt}",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "ask",
        "task": {
          "*": "deny",
          "scoper": "allow",
          "researcher": "allow",
          "reviewer": "allow",
          "general": "deny",
          "explore": "deny"
        }
      }
    },
    "scoper": {
      "description": "Creates bounded slices, milestones, and planning artifacts",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "todowrite": true,
        "edit": true,
        "write": true,
        "bash": false
      },
      "permission": {
        "edit": {
          "*": "deny",
          "docs/product-specs/*": "allow",
          "docs/design-docs/*": "allow",
          "docs/exec-plans/active/*": "allow"
        },
        "write": {
          "*": "deny",
          "docs/product-specs/*": "allow",
          "docs/design-docs/*": "allow",
          "docs/exec-plans/active/*": "allow"
        }
      }
    },
    "researcher": {
      "description": "Finds repo and external evidence without editing files",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "bash": true,
        "webfetch": true,
        "websearch": true,
        "codesearch": true,
        "edit": false,
        "write": false,
        "task": false,
        "todowrite": false
      },
      "permission": {
        "bash": {
          "*": "deny",
          "sqlite3 *": "allow"
        }
      }
    },
    "builder": {
      "description": "Focused implementation worker for code, tests, and verification",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "tools": {
        "edit": true,
        "write": true,
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "task": false,
        "todowrite": false
      }
    },
    "reviewer": {
      "description": "Independent validator for plans, code, QA, and safety",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low",
      "tools": {
        "read": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "edit": false,
        "write": false,
        "task": false,
        "todowrite": false
      }
    }
  }
}
