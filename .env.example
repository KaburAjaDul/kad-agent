NODE_ENV=development
LOG_LEVEL=info
# Keep true for DB-only smoke checks. Set to false before live Discord registration/runtime validation.
BOT_DRY_RUN=true
# observe is the safe default. operate enables setup/event/effect/reminder mutations.
KADDY_RUNTIME_MODE=observe
# disabled is the fail-closed default. observe reconciles Discord into private SQLite,
# synchronizes the current public revision, and permits local shadow approvals/outbox
# inspection without POSTing. active may dispatch a signed projection only after the
# explicit cutover flag is true and the legacy writer has no queued/in-progress run.
KADDY_PUBLICATION_MODE=disabled
KADDY_PUBLICATION_CUTOVER_CONFIRMED=false
DISCORD_TARGET_GUILD_ID=123456789012345678
DISCORD_TARGET_GUILD_NAME=Kabur Aja Dulu
KAD_PROJECTION_ENDPOINT=https://staging.example.test/internal/v1/projections/agenda
KAD_PUBLIC_AGENDA_ENDPOINT=https://staging.example.test/api/v1/agenda
KAD_PROJECTION_KEY_ID=staging-key-2026
# The public-ID key is required in observe and active so shadow output uses stable IDs.
# The signing key is active-only. Sensitive material must be mounted as files; direct
# key env vars are rejected.
# KAD_PROJECTION_SIGNING_PRIVATE_KEY_FILE=/run/secrets/kad_projection_signing_private_key
# KAD_PUBLIC_ID_KEY_FILE=/run/secrets/kad_public_id_key
DATABASE_PATH=./data/kad-agent.sqlite
JOB_POLL_INTERVAL_MS=30000
KADDY_PUBLICATION_OBSERVATION_INTERVAL_MS=60000
KADDY_PUBLICATION_PUBLISH_INTERVAL_MS=30000
KADDY_PUBLICATION_REQUEST_TIMEOUT_MS=9000
KADDY_PUBLICATION_LEASE_DURATION_MS=30000
KADDY_PUBLICATION_LEASE_HEARTBEAT_INTERVAL_MS=10000
STARTUP_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
RUNTIME_LEASE_DURATION_MS=30000
RUNTIME_LEASE_HEARTBEAT_INTERVAL_MS=10000
HEALTH_HOST=127.0.0.1
HEALTH_PORT=0
# Keep false unless the metrics listener is protected by a private tailnet/container network.
METRICS_EXPOSE_PRIVATE=false
DISCORD_APP_ID=123456789012345678
DISCORD_BOT_TOKEN=replace-with-your-bot-token
# Comma-separated guild snowflakes. Required whenever BOT_DRY_RUN=false.
DISCORD_ALLOWED_GUILD_IDS=123456789012345678
# Alternatively mount one secret per file; do not set a direct value and *_FILE together.
# DISCORD_APP_ID_FILE=/run/secrets/discord_app_id
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# DISCORD_ALLOWED_GUILD_IDS_FILE=/run/secrets/discord_allowed_guild_ids
