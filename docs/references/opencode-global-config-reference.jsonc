{
  "$schema": "https://opencode.ai/config.json",

  // Machine-local and personal preferences only.
  // Do not copy repo agents, repo prompts, repo plugins, or project policy here.
  // Real secret values must stay in environment variables or a local untracked file.

  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.5",

  // Provider credentials are read from the environment by OpenCode/provider SDKs.
  // Example shell setup, kept outside git:
  // export OPENAI_API_KEY="..."

  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "obsidian-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL}",
        "OBSIDIAN_VERIFY_SSL": "false",
        "OBSIDIAN_ENABLE_CACHE": "true",
        "OBSIDIAN_CACHE_REFRESH_INTERVAL_MIN": "10"
      }
    }
  },

  // Optional personal plugins belong here only when they are not required for
  // reproducible repo behavior. Repo-required plugins stay in project config
  // or under .opencode/plugins/ in the repository.
  "plugin": [
    // "personal-notification-plugin",
    // "personal-config-sync-plugin"
  ]
}
